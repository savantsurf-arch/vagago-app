# ==============================================================
# VagaGo - Variáveis de Ambiente (copie para .env e preencha)
# NUNCA faça commit do arquivo .env com chaves reais!
# ==============================================================

# Supabase (Frontend + Backend)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-secreta-aqui

# Pagamento Pix (Escolha asaas ou mercadopago)
PIX_PROVIDER=asaas
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Envio de E-mail com QR Code (Resend)
RESEND_API_KEY=
VAGAGO_FROM_EMAIL=VagaGo <reservas@vagago.com.br>

# Identidade & Atendimento Oficial
VITE_WHATSAPP_NUMBER=5573999990000
VITE_WHATSAPP_DISPLAY=(73) 99999-0000
VITE_COMPANY_CNPJ=Cadastro CNPJ em formalização • Itabuna - BA
VITE_CRISP_WEBSITE_ID=

# Monitoramento & Analytics
VITE_SENTRY_DSN=
VITE_GA4_ID=
VITE_PLAUSIBLE_DOMAIN=
